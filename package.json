{
  "name": "@mapcentia/gc2-sdk",
  "version": "0.3.1",
  "description": "GC2 (Geo Compute Cloud) TypeScript SDK",
  "author": "Martin Høgh",
  "license": "MIT",
  "type": "module",
  "main": "./dist/gc2-sdk.cjs",
  "module": "./dist/gc2-sdk.js",
  "types": "./dist/gc2-sdk.d.cts",
  "exports": {
    ".": {
      "require": "./dist/gc2-sdk.cjs",
      "import": "./dist/gc2-sdk.js"
    },
    "./node": {
      "import": {
        "types": "./dist/gc2-sdk-node.d.ts",
        "default": "./dist/gc2-sdk-node.js"
      },
      "require": {
        "types": "./dist/gc2-sdk-node.d.cts",
        "default": "./dist/gc2-sdk-node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "node.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "build-watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "configstore": "^7.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/configstore": "^6.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "tsdown": "^0.17.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  },
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "repository": "github:mapcentia/gc2-js-client",
  "homepage": "https://gc2.io/docs/sdk"
}
